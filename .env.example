# ═══════════════════════════════════════════════════════════════════════════════
# Jarvis AI Agent – Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM API Keys (mindestens einen eintragen) ──────────────────────────────
# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter (Zugang zu 100+ Modellen): https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Server-Konfiguration ───────────────────────────────────────────────────
# Öffentliche IP oder Domain für SSL-Zertifikat (wichtig für Remote-Zugriff)
SERVER_IP=127.0.0.1
SERVER_PORT=443

# ─── VNC / Desktop ──────────────────────────────────────────────────────────
VNC_PORT=5900
WEBSOCKIFY_PORT=6080

# ─── Sicherheit ─────────────────────────────────────────────────────────────
# Nur im Docker-Modus: Web-Login-Kennwort für den Benutzer "jarvis".
# LEER LASSEN: dann wird beim ersten Start ein Zufallskennwort erzeugt
# (docker logs jarvis). Standardkennwörter wie "jarvis" werden nicht
# angenommen; beim ersten Login muss das Kennwort geändert werden.
# Ohne Docker meldet sich "jarvis" mit seinem Linux-Kennwort an.
JARVIS_PASSWORD=

# Geheimer Schlüssel für die Signatur der Anmelde-Tokens.
# LEER LASSEN: dann erzeugt Jarvis beim ersten Start einen Zufallsschlüssel
# und legt ihn in data/.secret_key ab. Wer einen eigenen setzt:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# NIE einen Wert aus einer Anleitung oder diesem Repo verwenden.
SECRET_KEY=

# ─── Server-Ziele (nur Entwickler-Werkzeuge und live_-Proben) ───────────────
# Interne Adressen stehen NIE im Repo. Werkzeuge lesen sie hier oder aus der
# Umgebung (deploy/ziele.py); fehlt ein Wert, brechen sie mit Exit 2 ab.
JARVIS_DEV_SSH=root@<dev-host>
JARVIS_DEV_URL=https://<dev-host>
JARVIS_ECHT_SSH=<benutzer>@<echt-host>
# Kennwort des ECHT-Benutzers (sudo -S, ueber stdin – nie als Argument)
JARVIS_ECHT_PASS=
# jarvis-ai.info: SFTP Port 8023 (deploy/jarvis_ai_sftp.py)
JARVIS_SFTP_PASS=
