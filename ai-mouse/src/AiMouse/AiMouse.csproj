<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AiMouse</AssemblyName>
    <RootNamespace>AiMouse</RootNamespace>
    <!-- ⚠ DIE EINE QUELLE DER VERSION (seit 1.0.0, 2026-09-11).
         Sie beschreibt den CLIENT-CODE, also gehoert sie zu ihm – nicht in eine
         Backend-Konstante, die eine Kopie waere und driften wuerde. Der Server
         LIEST sie hier (`ai_mouse.klient_version()`) und nennt sie in
         `/api/ai-mouse/health`; die Anwendung liest ihre EIGENE Assembly. Damit
         koennen Server und EXE nicht auseinanderlaufen, solange die EXE aus
         dieser Datei gebaut ist – und dafuer sorgt `bau_noetig()`: `.csproj`
         zaehlt in `quellen_stand()`, eine Erhoehung hier loest den Neubau aus.
         ⚠ WER SIE HOCHZAEHLT, LOEST AUF JEDEM ARBEITSPLATZ EIN UPDATE AUS. -->
    <!-- 1.0.1 (2026-09-11): Beschriftung „Ziehen nur mit Taste".
         ⚠ EINE TEXTAENDERUNG IST EINE VERSION WERT. Ohne Erhoehung baut der
         Server zwar neu (`.cs` zaehlt in `quellen_stand()`), aber ein
         Arbeitsplatz mit 1.0.0 bekommt KEIN Update – die Serverversion waere
         unveraendert, und `IstNeuer` sagt zu Recht nein. Der neue Text waere
         damit nur fuer Neu-Downloads da. -->
    <!-- 1.0.2 (2026-09-11): die Version steht jetzt im Marken-Kopf und in der
         Portal-Kachel. Bis dahin war sie nur ueber die Windows-Dateieigenschaften
         zu sehen – ausgerechnet die Nummer, die man beim Melden eines Fehlers
         zuerst braucht. -->
    <!-- 1.0.3 (2026-09-12): Tastenkombination zum STARTEN + Autostart.
         Beides ueber eine Windows-VERKNUEPFUNG, nicht ueber `RegisterHotKey`:
         ein nicht laufendes Programm kann keinen Hotkey registrieren, und
         genau das soll die Kombination ja tun. Dazu meldet sich ein Zweitstart
         bei der laufenden Instanz, statt einen modalen Dialog zu zeigen – seit
         es den Hotkey gibt, ist der Zweitstart der NORMALFALL, und der Dialog
         haette ihn zuverlaessig zur Fehlermeldung gemacht. -->
    <!-- 1.0.4 (2026-09-14): der Einstellungsdialog zeigt wieder ALLE Zeilen.
         Gemeldet als „ich kann keine Einstellung fuer die Tastenkombination
         finden" – sie war seit 1.0.3 da, nur ausserhalb des Fensters: die
         Zeilenzahl war seit dem Erstimport von 7 auf 14 gewachsen, die feste
         `ClientSize` von 420 px nie mit. Ein `FixedDialog` ohne Rollbalken
         schneidet nicht ab, er laesst weg – ohne jeden Hinweis. Die Hoehe wird
         jetzt aus dem Inhalt gerechnet, `AutoScroll` faengt den Rest, und das
         Fenster ist ziehbar. -->
    <!-- 1.0.5 (2026-09-14): zwei gemeldete Fehler.
         a) Das stille Update wechselte die Datei ein und startete NICHT neu:
            `ReleaseMutex()` gibt die Besitzerschaft frei, nicht den NAMEN – die
            neu gestartete Fassung hielt sich fuer einen Zweitstart und beendete
            sich wortlos. Jetzt wird das Handle GESCHLOSSEN (Program.cs).
         b) Der Einstellungsdialog war zerschossen: die automatische Platzierung
            im TableLayoutPanel ueberspringt UNSICHTBARE Controls, und
            `_rdHinweis` ist im Regelfall unsichtbar – ab dort rutschte alles um
            eine Zelle. Jetzt werden die Zellen ausdruecklich angegeben, und
            Zeilen ohne Beschriftung gehen ueber beide Spalten. -->
    <!-- 1.0.6 (2026-09-14): die Anwendung liess sich nicht mehr beenden.
         Gemeldet als „haengt sich so auf, dass sie nicht ohne System-Neustart
         zu entfernen ist" – zwei Prozesse, leere Fenster, Tray-Symbole blieben,
         `taskkill /F` wirkungslos, und selbst das Loeschen der EXE half nicht.
         URSACHE: `ZiehbarPruefer` erzeugte JE ABFRAGE einen STA-Thread und gab
         ihn nach der Zeitgrenze auf. Antwortet die Zielanwendung nicht, bleibt
         der Thread im Kernel-Wait stehen – mit COM-Apartment und Proxy. Sie
         haeuften sich unbegrenzt an; beim Beenden terminiert `ExitProcess` sie,
         ohne dass sie ihre OLE32-Sperren freigeben, und die Detach-Sequenz
         laeuft in einen Deadlock. Jetzt genau EIN wiederverwendeter Worker
         (haengt er, wird uebersprungen statt nachgelegt), dazu als Netz
         darunter ein hartes `TerminateProcess` am Ende und ein Wachhund ueber
         dem Aufraeumen. -->
    <Version>1.0.6</Version>
    <!-- DPI awareness is owned by app.manifest, not by ApplicationHighDpiMode: it has to
         be in effect from process start, before any screen coordinate is read.
         WFAC010 asks for the opposite; suppressed because that trade-off is intentional. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Portable single-file publish.
       Note: Native AOT / PublishTrimmed are NOT supported by WinForms, so the
       spec's alternative (single-file publishing) is used instead. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Force System.Text.Json source generation; no reflection-based fallback. -->
  <PropertyGroup>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
