<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AiMouse</AssemblyName>
    <RootNamespace>AiMouse</RootNamespace>
    <!-- ⚠ DIE EINE QUELLE DER VERSION (seit 1.0.0, 2026-09-11).
         Sie beschreibt den CLIENT-CODE, also gehoert sie zu ihm – nicht in eine
         Backend-Konstante, die eine Kopie waere und driften wuerde. Der Server
         LIEST sie hier (`ai_mouse.klient_version()`) und nennt sie in
         `/api/ai-mouse/health`; die Anwendung liest ihre EIGENE Assembly. Damit
         koennen Server und EXE nicht auseinanderlaufen, solange die EXE aus
         dieser Datei gebaut ist – und dafuer sorgt `bau_noetig()`: `.csproj`
         zaehlt in `quellen_stand()`, eine Erhoehung hier loest den Neubau aus.
         ⚠ WER SIE HOCHZAEHLT, LOEST AUF JEDEM ARBEITSPLATZ EIN UPDATE AUS. -->
    <!-- 1.0.1 (2026-09-11): Beschriftung „Ziehen nur mit Taste".
         ⚠ EINE TEXTAENDERUNG IST EINE VERSION WERT. Ohne Erhoehung baut der
         Server zwar neu (`.cs` zaehlt in `quellen_stand()`), aber ein
         Arbeitsplatz mit 1.0.0 bekommt KEIN Update – die Serverversion waere
         unveraendert, und `IstNeuer` sagt zu Recht nein. Der neue Text waere
         damit nur fuer Neu-Downloads da. -->
    <Version>1.0.1</Version>
    <!-- DPI awareness is owned by app.manifest, not by ApplicationHighDpiMode: it has to
         be in effect from process start, before any screen coordinate is read.
         WFAC010 asks for the opposite; suppressed because that trade-off is intentional. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Portable single-file publish.
       Note: Native AOT / PublishTrimmed are NOT supported by WinForms, so the
       spec's alternative (single-file publishing) is used instead. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Force System.Text.Json source generation; no reflection-based fallback. -->
  <PropertyGroup>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
